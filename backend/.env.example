# Copiar como .env y ajustar si hace falta.
# Los valores por defecto coinciden con los de docker-compose.yml, así que
# levantando el contenedor no es necesario modificar nada.

# Puerto en el que escucha el API
PORT=3000

# Conexión a PostgreSQL.
# El puerto es 5433 y no 5432 porque docker-compose publica el contenedor en ese
# puerto para no chocar con una instalación local de PostgreSQL.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=evm
DATABASE_PASSWORD=evm
DATABASE_NAME=evm
